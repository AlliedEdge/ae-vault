# ============================================
# Ziboto Root Environment Variables
# ============================================
# This file contains shared environment variables
# Application-specific variables are in apps/*/. env.example

# ============================================
# General Configuration
# ============================================
NODE_ENV=development
ENVIRONMENT=development

# ============================================
# Docker Compose Configuration
# ============================================
COMPOSE_PROJECT_NAME=ziboto

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ziboto
POSTGRES_USER=ziboto
POSTGRES_PASSWORD=change-this-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Application URLs
# ============================================
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ============================================
# Security (Generate using secure random generators)
# ============================================
JWT_SECRET=generate-a-secure-256-bit-secret-key-change-this
ENCRYPTION_KEY=generate-a-secure-encryption-key-change-this

# ============================================
# Third-party Services (Add as needed)
# ============================================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# SENDGRID_API_KEY=your-sendgrid-api-key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password

# SENTRY_DSN=your-sentry-dsn
# GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
