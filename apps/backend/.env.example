# Spring Configuration
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/ziboto
DATABASE_USERNAME=ziboto
DATABASE_PASSWORD=ziboto
DATABASE_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Redis Rate Limiting
REDIS_RATE_LIMIT_LOGIN_MAX=5
REDIS_RATE_LIMIT_LOGIN_WINDOW=15
REDIS_RATE_LIMIT_SIGNUP_MAX=3
REDIS_RATE_LIMIT_SIGNUP_WINDOW=60
REDIS_RATE_LIMIT_API_MAX=100
REDIS_RATE_LIMIT_API_WINDOW=1
REDIS_RATE_LIMIT_REFRESH_MAX=10
REDIS_RATE_LIMIT_REFRESH_WINDOW=1

# Redis Failed Login Tracking
REDIS_FAILED_LOGIN_MAX=5
REDIS_FAILED_LOGIN_LOCKOUT=30
REDIS_FAILED_LOGIN_TRACKING=1

# Redis Session Cache
REDIS_SESSION_TTL=1
REDIS_SESSION_EXTENDED_TTL=24
REDIS_SESSION_SLIDING_WINDOW=true
REDIS_SESSION_MAX_CONCURRENT=0

# Redis Token Blacklist
REDIS_TOKEN_BLACKLIST_ENABLED=true
REDIS_TOKEN_BLACKLIST_MAX_TTL=7

# Redis OTP Configuration
REDIS_OTP_TTL=5
REDIS_OTP_MAX_ATTEMPTS=3
REDIS_OTP_RATE_LIMIT=15
REDIS_OTP_MAX_VERIFY=3

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits
JWT_EXPIRATION=900000 # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION=604800000 # 7 days in milliseconds

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Configuration
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/ziboto/storage

# S3 Configuration (if STORAGE_TYPE=s3)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# File Upload Configuration
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB

# Cache Configuration
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/ziboto.log
